        <mxCell id="sm-cart-note-1" value="&lt;b&gt;Pengurangan jumlah (CART-3, TBD-3)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px;color:#5B4A1F;&quot;&gt;Jumlah dapat ditambah atau dikurangi.&lt;br&gt;Perilaku saat jumlah turun di bawah 1&lt;br&gt;(hapus otomatis vs blokir) masih TBD.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFBE6;strokeColor=#D6B656;strokeWidth=1;dashed=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=12;fontColor=#5B4A1F;" vertex="1" parent="1">
          <mxGeometry x="1580" y="410" width="360" height="150" as="geometry" />
        </mxCell>
        <mxCell id="sm-cart-note-2" value="&lt;b&gt;Checkout (CHK-1, CHK-2, CHK-6, CHK-7)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px;color:#5B4A1F;&quot;&gt;Hanya untuk pengguna login dengan&lt;br&gt;keranjang tidak kosong. Jika alamat&lt;br&gt;invalid atau stok kurang, checkout gagal&lt;br&gt;tanpa pesanan parsial.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFBE6;strokeColor=#D6B656;strokeWidth=1;dashed=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=12;fontColor=#5B4A1F;" vertex="1" parent="1">
          <mxGeometry x="1580" y="590" width="360" height="150" as="geometry" />
        </mxCell>
        <mxCell id="sm-cart-note-3" value="&lt;b&gt;Persistensi (CART-7)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px;color:#5B4A1F;&quot;&gt;Keranjang disimpan per akun di basis data&lt;br&gt;dan tetap ada setelah logout/login. Saat login&lt;br&gt;dengan item tersimpan, state langsung Berisi.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFBE6;strokeColor=#D6B656;strokeWidth=1;dashed=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=12;fontColor=#5B4A1F;" vertex="1" parent="1">
          <mxGeometry x="1580" y="770" width="360" height="130" as="geometry" />
        </mxCell>
        <mxCell id="sm-cart-extra-0" value="Tidak ada state akhir: keranjang adalah wadah persisten; checkout berhasil mengosongkannya." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#6B7280;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="200" y="905" width="1600" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
