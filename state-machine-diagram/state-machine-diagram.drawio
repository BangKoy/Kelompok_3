        <mxCell id="sm-order-note-2" value="&lt;b&gt;Di luar ruang lingkup v1.0 (AS-2, BR-6)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px;color:#5B4A1F;&quot;&gt;Tidak ada status Dibatalkan dan tidak ada&lt;br&gt;state pembayaran; pembayaran diselesaikan&lt;br&gt;di luar sistem. Pesanan baru selalu&lt;br&gt;berstatus Pending (BR-2).&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFBE6;strokeColor=#D6B656;strokeWidth=1;dashed=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=12;fontColor=#5B4A1F;" vertex="1" parent="1">
