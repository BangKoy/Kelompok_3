        <mxCell id="sm-product-note-0" value="&lt;b&gt;Perubahan stok (CAT-1, CHK-6, PRD-3)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px;color:#5B4A1F;&quot;&gt;Stok berkurang saat checkout berhasil (CHK-6).&lt;br&gt;Admin dapat menambah atau mengubah stok&lt;br&gt;kapan saja (PRD-3). Stok 0 membuat produk&lt;br&gt;berstatus Habis.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFBE6;strokeColor=#D6B656;strokeWidth=1;dashed=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=12;fontColor=#5B4A1F;" vertex="1" parent="1">
          <mxGeometry x="200" y="570" width="480" height="150" as="geometry" />
        </mxCell>
        <mxCell id="sm-product-note-1" value="&lt;b&gt;Kebijakan tampilan (TBD-1)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px;color:#5B4A1F;&quot;&gt;Apakah produk habis disembunyikan atau&lt;br&gt;ditampilkan nonaktif di katalog masih TBD.&lt;br&gt;Diagram ini hanya memodelkan ketersediaan&lt;br&gt;stok, bukan tampilan katalog.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFBE6;strokeColor=#D6B656;strokeWidth=1;dashed=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=12;fontColor=#5B4A1F;" vertex="1" parent="1">
