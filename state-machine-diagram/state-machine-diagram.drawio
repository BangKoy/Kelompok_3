        <mxCell id="sm-order-note-0" value="&lt;b&gt;Aturan transisi (TRX-3, TRX-4, BR-3)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px;color:#5B4A1F;&quot;&gt;Status hanya boleh maju satu langkah:&lt;br&gt;Pending → Diproses → Dikirim → Selesai.&lt;br&gt;Lompat status atau transisi mundur ditolak&lt;br&gt;dan menampilkan pesan kesalahan.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFBE6;strokeColor=#D6B656;strokeWidth=1;dashed=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=12;fontColor=#5B4A1F;" vertex="1" parent="1">
