        <mxCell id="sm-session-lbl-0" value="&lt;b&gt;login()&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px;color:#6B7280;&quot;&gt;[kredensial valid]&lt;br&gt;/ buat sesi&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#374151;" vertex="1" parent="1">
          <mxGeometry x="700" y="390" width="235" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sm-session-lbl-1" value="&lt;b&gt;logout(), sesiKedaluwarsa()&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px;color:#6B7280;&quot;&gt;/ hapus sesi&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#374151;" vertex="1" parent="1">
          <mxGeometry x="1065" y="390" width="275" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sm-session-lbl-2" value="&lt;b&gt;login()&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px;color:#6B7280;&quot;&gt;[kredensial salah]&lt;br&gt;/ tampilkan pesan&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#374151;" vertex="1" parent="1">
          <mxGeometry x="520" y="145" width="300" height="82" as="geometry" />
        </mxCell>
        <mxCell id="sm-session-note-0" value="&lt;b&gt;Peran pengguna (AUTH-7)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px;color:#5B4A1F;&quot;&gt;Sesi menyimpan peran CUSTOMER atau ADMIN.&lt;br&gt;Pelanggan diarahkan ke katalog; Admin&lt;br&gt;diarahkan ke dashboard setelah login.&lt;br&gt;Halaman admin tidak dapat diakses pelanggan.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFBE6;strokeColor=#D6B656;strokeWidth=1;dashed=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=12;fontColor=#5B4A1F;" vertex="1" parent="1">
          <mxGeometry x="1320" y="200" width="440" height="150" as="geometry" />
        </mxCell>
        <mxCell id="sm-session-note-1" value="&lt;b&gt;Halaman terproteksi (AUTH-8)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px;color:#5B4A1F;&quot;&gt;Tamu yang membuka keranjang, checkout,&lt;br&gt;riwayat pesanan, atau halaman admin&lt;br&gt;diarahkan ke halaman login.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFBE6;strokeColor=#D6B656;strokeWidth=1;dashed=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=12;fontColor=#5B4A1F;" vertex="1" parent="1">
          <mxGeometry x="1320" y="375" width="440" height="150" as="geometry" />
        </mxCell>
        <mxCell id="sm-session-note-2" value="&lt;b&gt;Batas sesi (AUTH-6, SEC-4)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px;color:#5B4A1F;&quot;&gt;Sesi bertahan sampai logout atau kedaluwarsa.&lt;br&gt;Cookie sesi bersifat HTTP-only dan Secure&lt;br&gt;saat disajikan melalui HTTPS.&lt;br&gt;Tidak ada state akhir; sesi kembali ke Tamu.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFBE6;strokeColor=#D6B656;strokeWidth=1;dashed=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=12;fontColor=#5B4A1F;" vertex="1" parent="1">
          <mxGeometry x="1320" y="550" width="440" height="150" as="geometry" />
        </mxCell>
        <mxCell id="sm-session-note-3" value="&lt;b&gt;Registrasi akun (AUTH-1 s.d. AUTH-4)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px;color:#5B4A1F;&quot;&gt;Pelanggan baru mendaftar dengan nama, email&lt;br&gt;unik, dan kata sandi minimal 8 karakter.&lt;br&gt;Registrasi berhasil diarahkan ke login.&lt;br&gt;Akun admin dibuat via seeding (AUTH-10).&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFBE6;strokeColor=#D6B656;strokeWidth=1;dashed=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=12;fontColor=#5B4A1F;" vertex="1" parent="1">
          <mxGeometry x="200" y="520" width="480" height="150" as="geometry" />
        </mxCell>
        <mxCell id="sm-session-note-4" value="&lt;b&gt;Akses tanpa login (CAT-5)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px;color:#5B4A1F;&quot;&gt;Katalog dapat diakses tanpa login.&lt;br&gt;Login diwajibkan saat checkout atau&lt;br&gt;membuka halaman terproteksi.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFBE6;strokeColor=#D6B656;strokeWidth=1;dashed=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=12;fontColor=#5B4A1F;" vertex="1" parent="1">
          <mxGeometry x="200" y="695" width="480" height="120" as="geometry" />
