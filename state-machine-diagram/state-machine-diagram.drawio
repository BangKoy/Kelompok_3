        <mxCell id="sm-order-note-1" value="&lt;b&gt;Perubahan status (TRX-5, TRX-6, BR-7)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px;color:#5B4A1F;&quot;&gt;Hanya Admin yang dapat mengubah status.&lt;br&gt;Setiap perubahan mencatat stempel waktu.&lt;br&gt;Pelanggan hanya melihat status terbaru&lt;br&gt;pada halaman Pesanan Saya (ORD-2, ORD-3).&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFBE6;strokeColor=#D6B656;strokeWidth=1;dashed=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=12;fontColor=#5B4A1F;" vertex="1" parent="1">
