        <mxCell id="title" value="Deployment Diagram — Aplikasi Web E-Commerce Frozen Food &amp; Snack&lt;br&gt;&lt;font style=&quot;font-size:12px;font-weight:normal;color:#555555;&quot;&gt;Kelompok 3 · Deployment produksi: Next.js (App Router) + Prisma + MySQL&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1F3864;" vertex="1" parent="1"><mxGeometry x="80" y="18" width="1440" height="52" as="geometry"/></mxCell>

        <mxCell id="phone" value="«device»&lt;br&gt;&lt;b&gt;Smartphone Pengguna&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;color:#555555;&quot;&gt;Pelanggan &amp;amp; Admin&lt;/font&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=10;container=1;collapsible=0;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1F3864;fontSize=14;" vertex="1" parent="1"><mxGeometry x="50" y="170" width="360" height="440" as="geometry"/></mxCell>
        <mxCell id="browser" value="«execution environment»&lt;br&gt;&lt;b&gt;Browser Mobile&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;color:#555555;&quot;&gt;Chrome / Safari&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1E4620;fontSize=13;align=center;verticalAlign=top;spacingTop=8;container=1;collapsible=0;" vertex="1" parent="phone"><mxGeometry x="25" y="80" width="310" height="330" as="geometry"/></mxCell>
        <mxCell id="browser-art" value="«artifact»&lt;br&gt;&lt;b&gt;UI Web Mobile-First&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#555555;&quot;&gt;HTML · CSS · JS bundle&lt;br&gt;React Server Components&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#5C4A00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="browser"><mxGeometry x="25" y="100" width="260" height="110" as="geometry"/></mxCell>

        <mxCell id="app" value="«device»&lt;br&gt;&lt;b&gt;Server Aplikasi&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;color:#555555;&quot;&gt;VPS / Cloud · Linux&lt;/font&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=10;container=1;collapsible=0;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1F3864;fontSize=14;" vertex="1" parent="1"><mxGeometry x="480" y="140" width="700" height="560" as="geometry"/></mxCell>
        <mxCell id="nginx" value="«execution environment»&lt;br&gt;&lt;b&gt;Nginx&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;color:#555555;&quot;&gt;Reverse proxy · TLS termination · static files&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1E4620;fontSize=13;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="app"><mxGeometry x="30" y="70" width="640" height="110" as="geometry"/></mxCell>

        <mxCell id="node" value="«execution environment»&lt;br&gt;&lt;b&gt;Node.js 20 LTS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;color:#555555;&quot;&gt;Proses aplikasi Next.js&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1E4620;fontSize=13;align=center;verticalAlign=top;spacingTop=8;container=1;collapsible=0;" vertex="1" parent="app"><mxGeometry x="30" y="230" width="640" height="290" as="geometry"/></mxCell>
        <mxCell id="art-next" value="«artifact»  &lt;b&gt;.next/&lt;/b&gt; — hasil build Next.js App Router&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#555555;&quot;&gt;Server Components · Route Handlers / Server Actions&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#5C4A00;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="node"><mxGeometry x="25" y="60" width="590" height="55" as="geometry"/></mxCell>
        <mxCell id="art-prisma" value="«artifact»  &lt;b&gt;prisma/&lt;/b&gt; + @prisma/client — skema &amp;amp; query builder&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#555555;&quot;&gt;schema.prisma · migrasi · connection pool&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#5C4A00;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="node"><mxGeometry x="25" y="130" width="590" height="55" as="geometry"/></mxCell>
        <mxCell id="art-public" value="«artifact»  &lt;b&gt;public/&lt;/b&gt; — gambar produk (imageUrl)&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#555555;&quot;&gt;Disajikan langsung oleh Nginx sebagai static file&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#5C4A00;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="node"><mxGeometry x="25" y="200" width="590" height="55" as="geometry"/></mxCell>

        <mxCell id="db" value="«device»&lt;br&gt;&lt;b&gt;Server Database&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;color:#555555;&quot;&gt;Private network&lt;/font&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=10;container=1;collapsible=0;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1F3864;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1240" y="300" width="320" height="340" as="geometry"/></mxCell>
        <mxCell id="mysql" value="«DBMS»&lt;br&gt;&lt;b&gt;MySQL 8.0&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;color:#555555;&quot;&gt;port 3306&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1E4620;fontSize=13;align=center;verticalAlign=top;spacingTop=8;container=1;collapsible=0;" vertex="1" parent="db"><mxGeometry x="20" y="80" width="280" height="220" as="geometry"/></mxCell>
        <mxCell id="schema" value="«artifact»&lt;br&gt;&lt;b&gt;skema &lt;i&gt;ecommerce&lt;/i&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#555555;&quot;&gt;User · Product · CartItem&lt;br&gt;Order · OrderItem&lt;br&gt;+ indeks &amp;amp; foreign key&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#5C4A00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="mysql"><mxGeometry x="20" y="90" width="240" height="110" as="geometry"/></mxCell>

        <mxCell id="e-browser-nginx" value="HTTPS 443" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.3;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;" edge="1" source="browser" target="nginx" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="450" y="415"/></Array></mxGeometry></mxCell>

        <mxCell id="e-nginx-node" value="HTTP :3000" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.3;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;" edge="1" source="nginx" target="node" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="e-node-mysql" value="TCP 3306" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.3;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;" edge="1" source="node" target="mysql" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1210" y="515"/></Array></mxGeometry></mxCell>

        <mxCell id="note" value="&lt;b&gt;Asumsi Deployment&lt;/b&gt;&lt;br&gt;• Satu VPS/cloud menjalankan Nginx (TLS termination) dan Node.js 20 LTS; Next.js App Router di-build ke &lt;b&gt;.next/&lt;/b&gt;.&lt;br&gt;• MySQL 8.0 berada pada server terpisah di private network; hanya server aplikasi yang boleh mengakses port 3306.&lt;br&gt;• Prisma Client berjalan di proses Node.js; kredensial database dibaca dari environment variable (&lt;b&gt;.env&lt;/b&gt;), tidak di-hardcode.&lt;br&gt;• Gambar produk disajikan dari &lt;b&gt;public/&lt;/b&gt; melalui Nginx; kolom &lt;b&gt;imageUrl&lt;/b&gt; menyimpan path/URL-nya.&lt;br&gt;• Pelanggan dan admin memakai aplikasi yang sama melalui browser mobile dengan koneksi HTTPS.&lt;br&gt;• Alternatif serverless (mis. Vercel + MySQL terkelola) memiliki komponen logis yang sama: browser, runtime Node.js, dan DBMS." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF8E1;strokeColor=#D6B656;size=14;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=10;fontColor=#5C4A00;" vertex="1" parent="1"><mxGeometry x="480" y="750" width="700" height="200" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>